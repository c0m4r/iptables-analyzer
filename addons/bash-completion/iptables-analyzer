# Bash completion for iptables-analyzer
# Install to /usr/share/bash-completion/completions/iptables-analyzer
# or source from ~/.bashrc

_iptables_analyzer() {
    # _init_completion assigns these variables; this function reads two of them.
    # shellcheck disable=SC2034
    local cur prev words cword split
    _init_completion -s || return

    case "$prev" in
        -f|--file|--file6|--services-file|--ipset-file|--html|--snapshot)
            _filedir
            return
            ;;
        --expect)
            mapfile -t COMPREPLY < <(compgen -W "accept drop reject" -- "$cur")
            return
            ;;
        --trace)
            # A packet, for example: 'tcp 203.0.113.5 -> :22 in eth0'
            return
            ;;
        --sandbox)
            mapfile -t COMPREPLY < <(compgen -W "auto strict off" -- "$cur")
            return
            ;;
        --fail-on)
            mapfile -t COMPREPLY < <(compgen -W "low medium high critical" -- "$cur")
            return
            ;;
        --min-grade)
            mapfile -t COMPREPLY < <(compgen -W "A B C D" -- "$cur")
            return
            ;;
        --baseline)
            # The value of --baseline must follow "=", so the next word is
            # an option or a file.
            ;;
        --public)
            mapfile -t COMPREPLY < <(compgen -W "tcp/80,tcp/443 tcp/ udp/" -- "$cur")
            return
            ;;
    esac

    if [[ "$cur" == -* ]]; then
        local opts="
            -f --file
            --file6
            --services-file
            --ipset-file
            -4 --ipv4-only
            -6 --ipv6-only
            --public
            --trace
            --expect
            --diff
            --snapshot
            --html
            --json
            --rules
            -v --verbose
            -q --quiet
            -s --score-only
            --fail-on
            --min-grade
            --baseline --baseline=4 --baseline=6 --baseline=all
            --no-color
            --sandbox
            -V --version
            -h --help
        "
        mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
        return
    fi

    # Saved iptables-save, ip6tables-save and ss output, or a snapshot.
    _filedir
}

complete -F _iptables_analyzer iptables-analyzer
