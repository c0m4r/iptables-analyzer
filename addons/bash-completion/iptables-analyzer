# Bash completion for iptables-analyzer
# Install to /usr/share/bash-completion/completions/iptables-analyzer
# or source from ~/.bashrc

_iptables_analyzer() {
    local cur prev
    _init_completion || return

    case "$prev" in
        -f|--file)
            _filedir
            return
            ;;
        --file6)
            _filedir
            return
            ;;
        --services-file)
            _filedir
            return
            ;;
    esac

    if [[ "$prev" == --sandbox ]]; then
        mapfile -t COMPREPLY < <(compgen -W "auto strict off" -- "$cur")
        return
    fi

    if [[ "$cur" == --sandbox=* ]]; then
        mapfile -t COMPREPLY < <(compgen -W "--sandbox=auto --sandbox=strict --sandbox=off" -- "$cur")
        return
    fi

    if [[ "$cur" == --baseline=* ]]; then
        mapfile -t COMPREPLY < <(compgen -W "--baseline=4 --baseline=6 --baseline=all" -- "$cur")
        return
    fi

    if [[ "$cur" == -* ]]; then
        local opts="
            -f --file
            --file6
            -4 --ipv4-only
            -6 --ipv6-only
            --no-color
            --json
            -v --verbose
            --services-file
            -s --score-only
            --baseline --baseline=4 --baseline=6 --baseline=all
            --sandbox --sandbox=auto --sandbox=strict --sandbox=off
            -V --version
            -h --help
        "
        mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
        return
    fi
}

complete -F _iptables_analyzer iptables-analyzer
